    <!-- Helps contact stability -->
    <maxVel>0.1</maxVel>
    <!-- Prevents "launching" on contact -->
    <fdir1>1 0 0</fdir1>
    <!-- Direction of mu1 -->
  </gazebo>
  <gazebo reference="calfFeet_BR">
    <mu1>0.5</mu1>
    <!-- Static Friction -->
    <mu2>0.5</mu2>
    <!-- Dynamic Friction -->
    <kp>1000000.0</kp>
    <!-- Contact Stiffness -->
    <kd>1.0</kd>
    <!-- Damping -->
    <minDepth>0.001</minDepth>
    <!-- Helps contact stability -->
    <maxVel>0.1</maxVel>
    <!-- Prevents "launching" on contact -->
    <fdir1>1 0 0</fdir1>
    <!-- Direction of mu1 -->
  </gazebo>
  <!-- ================================================================================================================================== -->
  <gazebo reference="batteryHolder">
    <collision>
      <surface>
        <contact>
          <ode>
            <min_depth>0.001</min_depth>
            <!-- enforcing convexity -->
          </ode>
        </contact>
      </surface>
    </collision>
  </gazebo>
