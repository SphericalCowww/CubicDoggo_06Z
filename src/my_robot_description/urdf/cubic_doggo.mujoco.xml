<mujoco model="scene_doggo">
    <compiler angle="radian" coordinate="local" inertiafromgeom="true" autolimits="true"/>
    <option iterations="100" tolerance="1e-10" solver="Newton" gravity="0 0 -9.81">
        <flag contact="enable" energy="enable"/>
    </option>
    <default>
        <geom contype="1" conaffinity="1" friction="0.4 0.005 0.0001" solref="0.02 1" solimp="0.9 0.95 0.001"/>
        <joint damping="0.1" armature="0.01" frictionloss="0.05" ref="0.0"/>
        <default class="foot_friction">
            <geom friction="0.5 0.005 0.0001" 
                  solref="0.01 1" 
                  solimp="0.9 0.99 0.001" 
                  margin="0.001" 
                  rgba="0.8 0.1 0.1 1"/>
        </default>
    </default>
    <visual>
        <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    </visual>
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture type="2d" name="grid" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .15 .2" width="512" height="512"/>
        <material name="grid_mat" texture="grid" texrepeat="5 5" reflectance="0.2"/>
    </asset>

    <worldbody>
        <light pos="0 0 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="5 5 0.1" material="grid_mat" contype="1" conaffinity="1" group="2"/>
        <body name="robot_root" pos="0 0 0">
            <freejoint name="root"/>
            <include file="cubic_doggo.mujoco.urdf"/>
            <geom name="imu_board" 
                  type="box" 
                  pos="0.0 0.0475 -0.002" 
                  euler="3.14159 0 3.14159" 
                  size="0.0135 0.0105 0.002" 
                  rgba="0 0 1 1" 
                  mass="0.005"
                  group="1"/>
            <site name="imu_site" 
                  pos="0.0 0.0475 -0.002" 
                  euler="3.14159 0 3.14159" 
                  size="0.001" 
                  rgba="1 0 0 1"/>
        </body>
    </worldbody>
    <keyframe>
        <key name="initial_condition" qpos="0 0 0.15  0 0 1 0  3.14 2.54 4.14 4.14  3.14 3.74 2.14 2.14
                                                               3.14 2.54 4.14 4.14  3.14 3.74 2.14 2.14" 
                                      ctrl="                   3.14 2.54 4.14       3.14 3.74 2.14
                                                               3.14 2.54 4.14       3.14 3.74 2.14"/>
    </keyframe>
    <equality>
        <joint joint1="servo3_calfFeet_FL" joint2="servo3_calfJoint_FL" polycoef="0 1 0 0 0"/>
        <joint joint1="servo3_calfFeet_FR" joint2="servo3_calfJoint_FR" polycoef="0 1 0 0 0"/>
        <joint joint1="servo3_calfFeet_BL" joint2="servo3_calfJoint_BL" polycoef="0 1 0 0 0"/>
        <joint joint1="servo3_calfFeet_BR" joint2="servo3_calfJoint_BR" polycoef="0 1 0 0 0"/>
    </equality>
    <actuator>
        <position name="servo1_servo1_padding_FL" 
                  joint="servo1_servo1_padding_FL" 
                  kp="100"
                  ctrlrange="2.09 4.18" 
                  forcerange="-1.4 1.4"/>
        <position name="servo2_servo2_padding_FL" 
                  joint="servo2_servo2_padding_FL" 
                  kp="100" 
                  ctrlrange="2.62 4.71" 
                  forcerange="-1.4 1.4"/>
        <position name="servo3_calfFeet_FL" 
                  joint="servo3_calfFeet_FL" 
                  kp="100" 
                  ctrlrange="1.96 4.32" 
                  forcerange="-1.4 1.4"/>

        <position name="servo1_servo1_padding_FR" 
                  joint="servo1_servo1_padding_FR" 
                  kp="100"
                  ctrlrange="2.09 4.18" 
                  forcerange="-1.4 1.4"/>
        <position name="servo2_servo2_padding_FR" 
                  joint="servo2_servo2_padding_FR" 
                  kp="100" 
                  ctrlrange="1.57 3.67" 
                  forcerange="-1.4 1.4"/>
        <position name="servo3_calfFeet_FR" 
                  joint="servo3_calfFeet_FR" 
                  kp="100" 
                  ctrlrange="1.96 4.32" 
                  forcerange="-1.4 1.4"/>

        <position name="servo1_servo1_padding_BL" 
                  joint="servo1_servo1_padding_BL" 
                  kp="100"
                  ctrlrange="2.09 4.18" 
                  forcerange="-1.4 1.4"/>
        <position name="servo2_servo2_padding_BL" 
                  joint="servo2_servo2_padding_BL" 
                  kp="100" 
                  ctrlrange="1.57 3.67" 
                  forcerange="-1.4 1.4"/>
        <position name="servo3_calfFeet_BL" 
                  joint="servo3_calfFeet_BL" 
                  kp="100" 
                  ctrlrange="1.96 4.32" 
                  forcerange="-1.4 1.4"/>

        <position name="servo1_servo1_padding_BR" 
                  joint="servo1_servo1_padding_BR" 
                  kp="100"
                  ctrlrange="2.09 4.18" 
                  forcerange="-1.4 1.4"/>
        <position name="servo2_servo2_padding_BR" 
                  joint="servo2_servo2_padding_BR" 
                  kp="100" 
                  ctrlrange="2.62 4.71" 
                  forcerange="-1.4 1.4"/>
        <position name="servo3_calfFeet_BR" 
                  joint="servo3_calfFeet_BR" 
                  kp="100" 
                  ctrlrange="1.96 4.32" 
                  forcerange="-1.4 1.4"/>
    </actuator>
    <sensor>
        <accelerometer name="accel" site="imu_site"/>
        <gyro          name="gyro"  site="imu_site"/>
        <framequat     name="quat"  objtype="site" objname="imu_site"/>
    </sensor>
</mujoco>
