<mujoco model="scene_leg1">
    <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
    <default>
        <geom contype="1" conaffinity="1" condim="3" friction="0.6 0.005 0.0001"/>
        <!--joint damping="0.5" armature="0.01" frictionloss="0.1"/-->
        <joint damping="1.0" armature="0.01" ref="3.14"/>  
    </default>
    <visual>
        <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    </visual>
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture type="2d" name="grid" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .15 .2" width="512" height="512"/>
        <material name="grid_mat" texture="grid" texrepeat="5 5" reflectance="0.2"/>
    </asset>
    <worldbody>
        <light pos="0 0 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="5 5 0.1" material="grid_mat" contype="1" conaffinity="1" group="2"/>
        <body name="robot_root" pos="0 0 0">
            <freejoint name="root"/>
            <include file="cubic_leg1.mujoco.urdf"/>
        </body>
    </worldbody>

    <keyframe>
        <!--key name="initial_condition" qpos="0 0 0.15  0 0 1 0  0.0 2.54 4.14 4.14"/-->
        <key name="initial_condition" qpos="0 0 0.15  0 0 1 0  4.18 "/>
    </keyframe>

    <!--equality>
        <joint joint1="servo3_calfFeet_FL" joint2="servo3_calfJoint_FL" polycoef="0 1 0 0 0"/>
    </equality>
    <contact>
        <exclude body1="calfFeet_FL" body2="calfJoint_FL"/>
        <exclude body1="robot_root" body2="calfFeet_FL"/> 
        <exclude body1="robot_root" body2="calfJoint_FL"/>
    </contact-->
</mujoco>
